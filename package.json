{
	"name": "my-app",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "next build",
		"dev": "next dev",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "eslint --cache",
		"lint:fix": "eslint  --cache --fix",
		"openspec:validate": "cd ../.. && openspec validate --strict",
		"start": "next start",
		"test": "vitest run",
		"test:component": "vitest run --project component",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --pass-with-no-tests",
		"test:e2e:smoke": "playwright test --grep @smoke --pass-with-no-tests",
		"test:unit": "vitest run --project unit",
		"test:watch": "vitest",
		"typecheck": "bun run typegen && tsc --noEmit --pretty",
		"typegen": "next typegen"
	},
	"dependencies": {
		"@sentry/nextjs": "^10.61.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/devtools-a11y": "0.1.3",
		"@tanstack/react-devtools": "0.10.5",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-query-devtools": "5.101.0",
		"@unleash/nextjs": "^1.6.7",
		"allure-js-commons": "^3.10.0",
		"class-variance-authority": "0.7.1",
		"commons": "^0.0.1-pre",
		"nanoid": "5.1.11",
		"next": "16.2.9",
		"nuqs": "^2.8.9",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-use": "17.6.1",
		"sonner": "2.0.7",
		"uuid": "14.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.0.0",
		"@eslint-react/eslint-plugin": "5.9.0",
		"@next/eslint-plugin-next": "16.2.9",
		"@playwright/test": "1.61.0",
		"@svgr/webpack": "8.1.0",
		"@tailwindcss/postcss": "^4",
		"@total-typescript/ts-reset": "^0.6.1",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "6.0.2",
		"@vitest/browser-playwright": "4.1.9",
		"@vitest/coverage-v8": "4.1.9",
		"@vitest/runner": "4.1.9",
		"@vitest/ui": "4.1.9",
		"allure-js-commons": "3.10.0",
		"allure-playwright": "3.10.0",
		"allure-vitest": "3.10.0",
		"cz-conventional-changelog": "3.3.0",
		"eslint": "10.5.0",
		"eslint-config-next": "16.2.9",
		"eslint-config-prettier": "10.1.8",
		"eslint-formatter-gitlab": "7.1.0",
		"eslint-plugin-better-tailwindcss": "4.6.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react-refresh": "0.5.3",
		"lefthook": "2.1.9",
		"oxfmt": "0.55.0",
		"playwright": "1.61.0",
		"postcss": "8.5.15",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "4.1.9",
		"vitest-browser-react": "2.2.0"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"browserslist": [
		"defaults",
		"not dead"
	],
	"trustedDependencies": [
		"@sentry/cli",
		"sharp",
		"lefthook"
	]
}
