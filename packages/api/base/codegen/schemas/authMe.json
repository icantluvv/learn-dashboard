		"name": { "type": "string", "minLength": 3, "example": "Сергей" },
		"email": { "type": "string", "format": "email", "example": "user@example.com" },
		"gender": { "type": "string", "enum": ["male", "female", "other"], "example": "male" },
		"age": { "type": "integer", "minimum": 1, "maximum": 120, "example": 28 },
		"image": { "type": "string", "format": "uri", "example": "https://example.com/avatar.png" }
	},
